{
  "name": "@drift-ci/dashboard",
  "version": "1.2.3",
  "private": true,
  "description": "drift-ci self-hostable dashboard — Next.js 16 + Postgres",
  "scripts": {
    "build": "next build",
    "start": "next start",
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node scripts/migrate.mjs",
    "db:generate": "drizzle-kit generate",
    "retention:sweep": "node scripts/retention.mjs",
    "clean": "rimraf .next dist coverage"
  },
  "dependencies": {
    "@drift-ci/core": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "^16.4.3",
    "postgres": "^3.4.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.23",
    "rimraf": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
